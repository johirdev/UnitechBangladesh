# development = টেস্টিং (এসএমএস যায় না, OTP অটো)  |  production = লাইভ (আসল এসএমএস, Secure কুকি)
NODE_ENV=development
PORT=5000
DATABASE_URL=
BCRYPT_SALT_ROUND=12
NEXT_PUBLIC_SECRET_TOKEN=
JWT_SECRET=
JWT_EXPIRES_IN=60d
JWT_EXPIRES_IN_ADMIN=1d
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=150d
RESET_PASS_CLIENT_LINK=
EMail=
APP_NAME=Unitech Bangladesh
EMAIL_APP_PASSWORD=
BULKSMSBD_API_URL=http://bulksmsbd.net/api/smsapi
BULKSMSBD_API_KEY=
BULKSMSBD_SENDER_ID=
SMS_ENABLED=true
# development মোডে আসল এসএমএস পাঠাতে চাইলে true (ডিফল্ট: development এ এসএমএস যায় না, OTP নিজে বসে)
SMS_IN_DEV=false
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
NEXT_PUBLIC_API_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3000
# এসএমএসের রসিদ লিংকের ঠিকানা (না দিলে: production → http://unitechbangladesh.com, development → http://localhost:3000)
# SITE_URL=http://unitechbangladesh.com
# seed (npm run seed) — প্রথম Super Admin
SEED_ADMIN_PHONE=01700000000
SEED_ADMIN_PASSWORD=

DB_NAME=unitech_bangladesh
